# Never commit real credentials.
SLYTRADE_ENV=development
SLYTRADE_ALLOW_LIVE=0
SLYTRADE_STAGE=paper
SLYTRADE_METRICS_PORT=9108
SLYTRADE_METRICS_BIND=0.0.0.0
SLYTRADE_METRICS_ENABLED=1
SLYTRADE_USE_CPP_FEATURES=0
SLYTRADE_ENABLE_SYNTHETIC_L2=0

# Runtime / paper loop
SLYTRADE_SYMBOL=XAUUSD
SLYTRADE_TIMEFRAME=M1
SLYTRADE_STRATEGY=persona-adaptive
SLYTRADE_INITIAL_BALANCE=100000
SLYTRADE_POLL_SECONDS=1.0
SLYTRADE_LOG_LEVEL=INFO
SLYTRADE_JSON_LOGS=1

# Trading window (UTC)
SLYTRADE_TRADING_DAYS=mon,tue,wed,thu,fri
SLYTRADE_TRADING_START_UTC=00:00
SLYTRADE_TRADING_END_UTC=23:59

# Alerting (empty = disabled). Webhook is a generic JSON POST (Slack/Teams/Discord).
SLYTRADE_ALERT_WEBHOOK_URL=
SLYTRADE_ALERT_TELEGRAM_BOT_TOKEN=
SLYTRADE_ALERT_TELEGRAM_CHAT_ID=

# Red-folder news gate (see configs/news.yaml)
SLYTRADE_NEWS_ENABLED=0
SLYTRADE_NEWS_CONFIG_FILE=configs/news.yaml
