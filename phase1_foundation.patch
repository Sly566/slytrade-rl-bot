+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+
+
+@dataclass(frozen=True)
+class Tick:
+    symbol: str
+    time: datetime
+    bid: float
+    ask: float
+    last: float = 0.0
+    volume: float = 0.0
+
+    @property
+    def spread(self) -> float:
+        return self.ask - self.bid
+
+    @property
+    def mid(self) -> float:
+        return (self.bid + self.ask) / 2.0
+
+
+@dataclass(frozen=True)
+class Bar:
+    symbol: str
+    timeframe: str
+    time: datetime
+    open: float
+    high: float
+    low: float
+    close: float
+    tick_volume: float = 0.0
+    spread: float = 0.0
